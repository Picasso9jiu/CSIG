# Versioned binary release assets. Git LFS is required after cloning.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pkl.gz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
artifacts/*.zip filter=lfs diff=lfs merge=lfs -text

# WSL entry points must retain LF line endings after a Windows checkout.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
